+// GOLDEN KEY — consulta somente leitura no endpoint separado de TESTE.
+const WPA_TURNOS_TESTE_URL='https://script.google.com/macros/s/AKfycbzCJ33Px7RR8gzNcgy9glH1I3bn8GHldXuxJrZ-Ec-T6RiVfZPwmciwY9UvZ0_XvEyK/exec';
+function carregarStatusJSONP(tipo){
+  return new Promise((resolve,reject)=>{
+    const callback='wpaCb_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);
+    const script=document.createElement('script');
+    let concluido=false;
+    const finalizar=(erro,dados)=>{
+      if(concluido)return;
+      concluido=true;
+      clearTimeout(timer);
+      try{delete window[callback]}catch(_e){window[callback]=undefined}
+      script.remove();
+      erro?reject(erro):resolve(dados);
+    };
+    const timer=setTimeout(()=>finalizar(Error('Tempo esgotado ao consultar '+tipo)),15000);
+    window[callback]=(dados)=>{
+      if(!dados||dados.ok!==true||!Array.isArray(dados.registros)){
+        finalizar(Error(dados&&dados.erro||'Resposta inválida para '+tipo));
+        return;
+      }
+      finalizar(null,dados.registros.map(r=>({
+        data:String(r.data||'').trim(),
+        turno:String(r.turno||'').trim(),
+        linha:String(r.linha||'').trim(),
+        maquina:String(r.maquina||'').trim(),
+        status:String(r.status||tipo).trim().toUpperCase()
+      })));
+    };
+    script.onerror=()=>finalizar(Error('Falha ao consultar '+tipo));
+    script.src=WPA_TURNOS_TESTE_URL+'?acao=consultaStatusSPPFTeste&tipo='+
+      encodeURIComponent(tipo)+'&callback='+encodeURIComponent(callback)+'&_='+Date.now();
+    document.head.appendChild(script);
+  });
+}
+async function carregarSP(){
+  try{turnosSP=await carregarStatusJSONP('SP')}
+  catch(e){console.error('[WPA TESTE] SP:',e);turnosSP=[]}
+}
+async function carregarPF(){
+  try{turnosPF=await carregarStatusJSONP('PF')}
+  catch(e){console.error('[WPA TESTE] PF:',e);turnosPF=[]}
+}
